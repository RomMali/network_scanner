<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GalacticGuard.Views.AnalyticsView"
             Title="Alerts">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="{Binding Summary}" FontAttributes="Bold"/>
        <CollectionView ItemsSource="{Binding Alerts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Src, StringFormat='src {0}'}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
