<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 x:Class="GalacticGuard.Views.LogsView"
                 Title="IPS Logs"
                 BackgroundColor="Black">

    <VerticalStackLayout Padding="20">
        <Frame BackgroundColor="Gray" Padding="10" CornerRadius="10">
            <HorizontalStackLayout>
                <Label Text="IPS Status:" FontSize="18" TextColor="White" />
                <Label Text="{Binding ServiceStatus}" FontSize="18" FontAttributes="Bold"
                           TextColor="{Binding ServiceColor}" Margin="10,0,0,0"/>
            </HorizontalStackLayout>
        </Frame>
        <Entry Placeholder="Filter logs" Text="{Binding SearchText}" TextColor="White"/>
        <Frame BackgroundColor="White" Padding="10" CornerRadius="10" Margin="0,20,0,20">
            <ScrollView HeightRequest="300">
                <Label Text="{Binding FilteredLogContent}" TextColor="Black" FontSize="14"/>
            </ScrollView>
        </Frame>
        <HorizontalStackLayout Spacing="10">
            <Button Text="Start IPS" Command="{Binding StartServiceCommand}"
                        BackgroundColor="Green" TextColor="White" FontSize="16"/>
            <Button Text="Stop IPS" Command="{Binding StopServiceCommand}"
                        BackgroundColor="Red" TextColor="White" FontSize="16"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
