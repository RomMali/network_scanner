<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 x:Class="GalacticGuard.Views.LogsView"
                 Title="Service Logs"
                 BackgroundColor="Black">

    <VerticalStackLayout Padding="20">

        <!-- Service Status -->
        <Frame BackgroundColor="Gray" Padding="10" CornerRadius="10">
            <HorizontalStackLayout>
                <Label Text="Service Status:" FontSize="18" TextColor="White" />
                <Label Text="{Binding ServiceStatus}" FontSize="18" FontAttributes="Bold" 
                           TextColor="{Binding ServiceColor}" Margin="10,0,0,0"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Logs List -->
        <Frame BackgroundColor="White" Padding="10" CornerRadius="10" Margin="0,20,0,20">
            <ScrollView HeightRequest="300">
                <Label Text="{Binding LogContent}" TextColor="Black" FontSize="14"/>
            </ScrollView>
        </Frame>

        <!-- Buttons -->
        <HorizontalStackLayout Spacing="10">
            <Button Text="Start Sniffer" Command="{Binding StartServiceCommand}"
                        BackgroundColor="Green" TextColor="White" FontSize="16"/>
            <Button Text="Stop Sniffer" Command="{Binding StopServiceCommand}"
                        BackgroundColor="Red" TextColor="White" FontSize="16"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>

</ContentPage>
