<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GalacticGuard.Views.ReportsView"
             Title="Reports">
    <VerticalStackLayout Padding="16" Spacing="8">
        <Label Text="{Binding Summary}" FontAttributes="Bold"/>
        <CollectionView ItemsSource="{Binding Drops}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="4">
                        <Label Text="{Binding Src}"/>
                        <Label Text="{Binding Reason}" FontSize="12"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
