<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GalacticGuard.Views.LoginPage"
             Title="GalacticGuard Login">
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="GalacticGuard IPS" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Entry Placeholder="API base URL" Text="{Binding BaseUrl}"/>
        <Entry Placeholder="Username" Text="{Binding Username}"/>
        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True"/>
        <HorizontalStackLayout>
            <CheckBox IsChecked="{Binding RegisterAdvanced}"/>
            <Label Text="Register as Advanced" VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <Button Text="Login" Command="{Binding LoginCommand}"/>
        <Button Text="Register" Command="{Binding RegisterCommand}"/>
        <Label Text="{Binding ErrorMessage}" TextColor="Red"/>
    </VerticalStackLayout>
</ContentPage>
