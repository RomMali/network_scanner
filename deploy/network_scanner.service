[Unit]
Description=Network Scanner NAT IPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/network_scanner
Environment=FLASK_HOST=127.0.0.1
Environment=FLASK_PORT=5000
ExecStart=/opt/network_scanner/.venv/bin/python /opt/network_scanner/main.py
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15
# Last-resort fail-open if the process is SIGKILL'd and Python atexit never runs.
ExecStopPost=/bin/sh -c '/usr/sbin/iptables -D FORWARD -m comment --comment "network_scanner-nfqueue" -j NFQUEUE --queue-num 0 >/dev/null 2>&1 || true'

[Install]
WantedBy=multi-user.target
